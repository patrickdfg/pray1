rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return signedIn() &&
        request.auth.token.email_verified == true &&
        request.auth.token.email == 'egibynote105g@gmail.com';
    }
    function isOwner(roomId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/rooms/$(roomId)) &&
        get(/databases/$(database)/documents/rooms/$(roomId)).data.ownerId == request.auth.uid;
    }
    function isMember(roomId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid));
    }
    function isRoomActive(roomId) {
      return exists(/databases/$(database)/documents/rooms/$(roomId)) &&
        get(/databases/$(database)/documents/rooms/$(roomId)).data.archived == false;
    }
    function validPrayer() {
      return request.resource.data.keys().hasOnly([
          'title','content','startDate','endDate','updatedAt','createdAt','createdBy'
        ]) &&
        request.resource.data.title is string &&
        request.resource.data.title.size() > 0 &&
        request.resource.data.title.size() <= 100 &&
        request.resource.data.content is string &&
        request.resource.data.content.size() > 0 &&
        request.resource.data.content.size() <= 5000 &&
        request.resource.data.startDate is string &&
        request.resource.data.endDate is string;
    }
    function createdPrayer() {
      return validPrayer() &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;
    }
    function updatedPrayer() {
      return validPrayer() &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.updatedAt == request.time;
    }

    match /churchPrayers/{prayerId} {
      allow read: if signedIn();
      allow create: if isAdmin() && createdPrayer();
      allow update: if isAdmin() && updatedPrayer();
      allow delete: if isAdmin();
    }
    match /users/{userId}/prayers/{prayerId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn() && request.auth.uid == userId && createdPrayer();
      allow update: if signedIn() && request.auth.uid == userId && updatedPrayer();
      allow delete: if signedIn() && request.auth.uid == userId;
    }
    // Daily prayer check-ins are private to the signed-in user.
    // Checking a shared church/team prayer never changes another member's record.
    match /users/{userId}/prayerChecks/{checkId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn() && request.auth.uid == userId &&
        request.resource.data.keys().hasOnly([
          'day','kind','prayerId','roomId','titleSnapshot','roomName','checkedAt'
        ]) &&
        request.resource.data.day is string &&
        request.resource.data.day.size() == 10 &&
        request.resource.data.kind in ['church','team','personal'] &&
        request.resource.data.prayerId is string &&
        request.resource.data.roomId is string &&
        request.resource.data.titleSnapshot is string &&
        request.resource.data.titleSnapshot.size() <= 100 &&
        request.resource.data.roomName is string &&
        request.resource.data.checkedAt == request.time;
      allow update: if false;
      allow delete: if signedIn() && request.auth.uid == userId;
    }
    match /rooms/{roomId} {
      allow read: if signedIn();
      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly([
          'name','ownerId','ownerName','archived','startDate','endDate','createdAt'
        ]) &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 80 &&
        request.resource.data.archived == false &&
        request.resource.data.createdAt == request.time;
      allow update: if isOwner(roomId) &&
        request.resource.data.ownerId == resource.data.ownerId &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'archived','archivedAt','name','startDate','endDate'
        ]);
      allow delete: if false;

      match /members/{memberId} {
        allow get: if signedIn() && (request.auth.uid == memberId || isOwner(roomId));
        allow list: if isOwner(roomId);
        allow create: if signedIn() &&
          isRoomActive(roomId) &&
          memberId == request.auth.uid &&
          request.resource.data.keys().hasOnly(['uid','displayName','accessCode','joinedAt']) &&
          request.resource.data.uid == request.auth.uid &&
          request.resource.data.accessCode is string &&
          request.resource.data.accessCode.size() >= 4 &&
          request.resource.data.accessCode ==
            get(/databases/$(database)/documents/roomCodes/$(roomId)).data.code &&
          request.resource.data.joinedAt == request.time;
        allow update: if false;
        allow delete: if signedIn() && (request.auth.uid == memberId || isOwner(roomId));
      }
      match /prayers/{prayerId} {
        // Anyone who owns or has joined the room can read and add prayers.
        // The verified site admin can manage prayers across all rooms.
        allow read: if isRoomActive(roomId) &&
          (isOwner(roomId) || isMember(roomId) || isAdmin());
        allow create: if isRoomActive(roomId) &&
          (isOwner(roomId) || isMember(roomId) || isAdmin()) && createdPrayer();
        // Only the original author, room owner, or verified site admin may
        // change or remove an existing shared team prayer.
        allow update: if isRoomActive(roomId) && updatedPrayer() &&
          (isOwner(roomId) || isAdmin() ||
            (isMember(roomId) && resource.data.createdBy == request.auth.uid));
        allow delete: if isRoomActive(roomId) &&
          (isOwner(roomId) || isAdmin() ||
            (isMember(roomId) && resource.data.createdBy == request.auth.uid));
      }
    }
    match /roomCodes/{roomId} {
      allow read: if false;
      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly(['ownerId','code']) &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.code is string &&
        request.resource.data.code.size() >= 4 &&
        request.resource.data.code.size() <= 64 &&
        getAfter(/databases/$(database)/documents/rooms/$(roomId)).data.ownerId == request.auth.uid;
      allow update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}